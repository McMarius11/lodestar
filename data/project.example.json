            { "id": "t1", "label": "SQLite schema", "done": true },
            { "id": "t2", "label": "Path tree CRUD", "done": false },
            { "id": "t3", "label": "Search by prefix", "done": false }
          ]
        },
        {
          "id": "crypto",
          "label": "Client-side Encryption",
          "description": "XChaCha20-Poly1305 via libsodium, per-file content keys wrapped with a user master key. Master key derived from Argon2id of the passphrase. Rotation by re-wrapping — content keys never change.",
          "effort": "XL",
          "ms": "v0.2",
          "ganttStart": 5,
          "ganttEnd": 10,
          "deps": [{ "id": "blobs", "reason": "Stores encrypted blobs", "type": "build" }],
          "tasks": [
            { "id": "t1", "label": "libsodium bindings", "done": false },
            { "id": "t2", "label": "Per-file content key", "done": false },
            { "id": "t3", "label": "Key wrapping with master key", "done": false },
            { "id": "t4", "label": "Key rotation", "done": false }
          ]
        },
