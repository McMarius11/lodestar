      "features": [
        {
          "id": "api",
          "label": "HTTP API Server",
          "description": "The backbone HTTP layer everything else mounts on. Fastify-style router, structured logs, per-route rate limits, OpenAPI generated from handlers. **Not** a REST framework — each module owns its own route file.",
          "effort": "L",
          "ms": "v0.1",
          "ganttStart": 0,
          "ganttEnd": 3,
          "deps": [],
          "tasks": [
            { "id": "t1", "label": "Router + middleware stack", "done": true },
            { "id": "t2", "label": "OpenAPI spec generator", "done": true },
            { "id": "t3", "label": "Rate limiter", "done": false },
            { "id": "t4", "label": "Structured logging", "done": false }
          ]
        },
        {
          "id": "auth",
          "label": "Auth & Sessions",
          "description": "Session cookies, CSRF protection, Argon2id password hashing, sliding refresh window. No OAuth for v0.1 — that lands in v0.3 once the core is stable.",
          "effort": "M",
          "ms": "v0.1",
          "ganttStart": 2,
          "ganttEnd": 4,
          "deps": [{ "id": "api", "reason": "Mounts /auth routes", "type": "build" }],
          "tasks": [
            { "id": "t1", "label": "Argon2id password hashing", "done": true },
            { "id": "t2", "label": "Session cookies + CSRF", "done": true },
            { "id": "t3", "label": "Token refresh flow", "done": false }
          ]
        },
        {
          "id": "cli",
          "label": "Admin CLI",
          "effort": "S",
          "ms": "v0.1",
          "ganttStart": 3,
          "ganttEnd": 4,
