          "tasks": [
            { "id": "t1", "label": "User CRUD commands", "done": false },
            { "id": "t2", "label": "Backup trigger", "done": false }
          ]
        }
      ]
    },
    {
      "id": "storage",
      "label": "Storage",
      "color": "#FF5A1F",
      "features": [
        {
          "id": "blobs",
          "label": "Blob Store",
          "description": "Content-addressed layout on disk: `blobs/<sha256[0..2]>/<sha256[2..]>`. Chunked uploads with resumability, GC sweep once a day. Deliberately dumb — no encryption here, that lives in the Crypto module.",
          "effort": "L",
          "ms": "v0.2",
          "ganttStart": 4,
          "ganttEnd": 7,
          "deps": [{ "id": "api", "reason": "Upload / download endpoints", "type": "build" }],
          "tasks": [
            { "id": "t1", "label": "Content-addressed layout", "done": true },
            { "id": "t2", "label": "Chunked upload", "done": false },
            { "id": "t3", "label": "Resume on interrupt", "done": false },
            { "id": "t4", "label": "Garbage collection", "done": false }
          ]
        },
        {
          "id": "meta",
          "label": "Metadata Index",
          "effort": "M",
          "ms": "v0.2",
          "ganttStart": 5,
          "ganttEnd": 7,
