{
  "name": "lodestar",
  "private": true,
  "version": "0.2.0",
  "description": "Local-first project planner for software work. Electron + React + TS.",
  "author": "Marius Kamm <marius.kamm@protonmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/McMarius11/lodestar.git"
  },
  "homepage": "https://github.com/McMarius11/lodestar#readme",
  "bugs": {
    "url": "https://github.com/McMarius11/lodestar/issues"
  },
  "keywords": [
    "project-management",
    "electron",
    "react",
    "typescript",
    "local-first",
    "gantt",
    "kanban"
  ],
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "npm run notices && vite build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "notices": "node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.10",
    "immer": "^10.1.1",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "license-checker-rseidelsohn": "^4.4.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.lodestar.app",
    "productName": "Lodestar",
    "artifactName": "Lodestar-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist",
      "dist-electron"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "src/assets/fonts/geist/OFL.txt",
        "to": "fonts/Geist-OFL.txt"
      },
      {
        "from": "src/assets/fonts/instrument-serif/OFL.txt",
        "to": "fonts/InstrumentSerif-OFL.txt"
      },
      {
        "from": "data/project.example.json",
        "to": "project.example.json"
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    }
  }
}
